---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import ToolStrip from '../components/ToolStrip.astro';
import Experience from '../components/Experience.astro';
import Skills from '../components/Skills.astro';
import Footer from '../components/Footer.astro';
import { resume } from '../data/resume';
---

<Layout>
  <Header email={resume.basics.email} />
  <main>
    <Hero data={resume.basics} />
    <ToolStrip data={resume.signature} />
    <Experience
      data={resume.experience}
      earlyTitle={resume.earlyTitle}
      earlyNote={resume.earlyNote}
    />
    <Skills data={resume.skills} basics={resume.basics} education={resume.education} />
  </main>
  <Footer data={resume.basics} />
</Layout>
