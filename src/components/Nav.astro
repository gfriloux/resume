---
const links = [
  { href: '#hero', label: 'Accueil' },
  { href: '#xac',  label: 'XaC' },
  { href: '#about', label: 'Profil' },
  { href: '#experience', label: 'Expérience' },
  { href: '#skills', label: 'Compétences' },
  { href: '#contact', label: 'Contact' },
];
---
<nav id="topnav">
  <span class="led"></span>
  {links.map(l => <a href={l.href}>{l.label}</a>)}
</nav>

<script>
  const links = document.querySelectorAll('#topnav a');
  const io = new IntersectionObserver(entries => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        links.forEach(l => l.classList.remove('active'));
        document.querySelector(`#topnav a[href="#${e.target.id}"]`)?.classList.add('active');
      }
    });
  }, { rootMargin: '-40% 0px -55% 0px' });
  document.querySelectorAll('section[id], footer[id]').forEach(s => io.observe(s));
</script>

<style>
  nav {
    position: fixed; top: 14px; left: 50%;
    transform: translateX(-50%);
    z-index: 100;
    display: flex; align-items: center; gap: 4px;
    padding: 6px;
    border: 1px solid rgba(203,166,247,.18);
    background: rgba(30,30,46,.55);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border-radius: 999px;
    box-shadow: 0 10px 30px rgba(0,0,0,.35);
    max-width: calc(100vw - 24px);
    overflow-x: auto;
    scrollbar-width: none;
  }
  nav::-webkit-scrollbar { display: none; }
  .led {
    width: 8px; height: 8px; border-radius: 50%;
    background: var(--green); box-shadow: 0 0 8px var(--green);
    margin: 0 6px;
    animation: nav-blink 1.6s ease-in-out infinite;
    flex-shrink: 0;
  }
  @keyframes nav-blink {
    0%,100% { opacity: 1; }
    50%     { opacity: .35; }
  }
  a {
    font-family: var(--mono); font-size: .72rem;
    letter-spacing: .04em; white-space: nowrap;
    padding: 8px 14px; border-radius: 999px;
    color: var(--sub0);
    transition: color .2s, background .2s;
  }
  a:hover { color: var(--text); }
  a.active { color: var(--crust); background: var(--mauve); font-weight: 600; }
</style>
