---
import { resume } from '../data/resume';
import Icon from './Icon.astro';
import StatsPanel from './StatsPanel.astro';

interface Props { data: typeof resume.basics; }
const { data } = Astro.props;

const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
---
<section id="hero">
  <div class="container hero">
    <div class="col">
      <p class="avail no-print">
        <span class="dot" aria-hidden="true"></span>{data.availability}
      </p>

      <div class="titles">
        <h1>{data.name}</h1>
        <p class="subtitle">{data.title} · {data.subtitle}</p>
      </div>

      <p class="pitch">{data.pitch}</p>

      <div class="cta no-print">
        <a class="btn btn--primary" href={data.pdf}>
          <Icon name="download" />Télécharger le CV (PDF)
        </a>
        <a class="btn btn--secondary" href={`mailto:${data.email}`}>
          <Icon name="mail" />{data.email}
        </a>
        <a class="btn btn--ghost" href={data.github} rel="noopener">
          <Icon name="github" />{host(data.github)}
        </a>
      </div>

      <p class="print-contact">
        {data.email} · {host(data.website)} · {host(data.github)}
      </p>
    </div>

    <StatsPanel data={data} />
  </div>
</section>

<style>
  .hero {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    gap: 56px;
    /* Serré pour que la bande d'outils reste au-dessus de la ligne de flottaison */
    padding-block: 72px 56px;
  }

  .col {
    flex: 999 1 560px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 28px;
    animation: hero-in .3s ease;
  }

  @keyframes hero-in {
    from { opacity: 0; transform: translateY(8px); }
  }

  .avail {
    display: inline-flex;
    align-self: flex-start;
    align-items: center;
    gap: 10px;
    padding: 8px 14px;
    border: 1px solid var(--border-strong);
    border-radius: 999px;
    font-size: 14px;
    line-height: 1.3;
    color: var(--ok);
  }
  .dot {
    flex: none;
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--ok);
  }

  .titles { display: flex; flex-direction: column; gap: 12px; }

  h1 {
    font-size: clamp(44px, 6vw, 76px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -.03em;
    color: var(--text);
  }

  .subtitle {
    font-family: var(--mono);
    font-size: clamp(18px, 2vw, 22px);
    line-height: 1.35;
    color: var(--accent);
  }

  .pitch {
    max-width: 640px;
    font-size: 19px;
    line-height: 1.6;
    color: var(--text-body);
  }

  .cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px; }

  /* Visible uniquement dans le PDF, où les boutons disparaissent */
  .print-contact { display: none; }

  @media (max-width: 640px) {
    .hero { padding-block: 48px 56px; gap: 40px; }
    .col { gap: 22px; }
    .pitch { font-size: 17px; }
  }

  @media print {
    .hero {
      display: block !important;
      padding: 0 0 8pt !important;
    }
    .col { gap: 0 !important; display: block !important; }
    h1 { font-size: 22pt !important; letter-spacing: -.02em !important; }
    .titles { gap: 0 !important; }
    .subtitle { font-size: 11pt !important; margin-top: 2pt !important; }
    .pitch {
      max-width: none !important;
      font-size: 9pt !important;
      line-height: 1.45 !important;
      margin-top: 6pt !important;
    }
    /* La ligne la plus utile du CV papier : elle ne doit pas être la plus pâle. */
    .print-contact {
      display: block !important;
      font-family: var(--mono);
      font-size: 9.5pt !important;
      color: var(--text) !important;
      margin-top: 6pt !important;
    }
  }
</style>
