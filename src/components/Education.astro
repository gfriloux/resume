---
import { resume } from '../data/resume';
interface Props { data: typeof resume.education; }
const { data } = Astro.props;
---

<section id="education">
  <div class="edu-inner">
    <p class="section-eyebrow">05 · formation</p>
    <p class="section-title">Formation</p>
    <div class="edu-list">
      {data.map(item => (
        <div class="edu-card">
          <div class="edu-icon"><i class="nf nf-md-school"></i></div>
          <div class="edu-content">
            <div class="edu-degree">{item.degree}</div>
            <div class="edu-school">{item.school}</div>
          </div>
          <span class="edu-dates">{item.start} — {item.end}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  gsap.from('.edu-card', {
    scrollTrigger: { trigger: '#education', start: 'top 85%' },
    y: 24, opacity: 0, stagger: .1, duration: .6, ease: 'power3.out'
  });
</script>

<style>
  #education { padding: 80px 0; }
  .edu-inner { max-width: 1100px; margin: 0 auto; padding: 0 48px; }

  .section-title {
    font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--sub0); display: flex; align-items: center; gap: 14px; margin-bottom: 40px;
  }
  .section-title::before { content: ''; display: block; width: 3px; height: 1.1em; background: var(--mauve); border-radius: 2px; box-shadow: 0 0 8px rgba(203,166,247,.5); }
  .section-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, rgba(203,166,247,.25), transparent); }

  .edu-list { display: flex; flex-direction: column; gap: 16px; }
  .edu-card {
    display: flex; align-items: center; gap: 20px;
    background: rgba(255,255,255,.025); border: 1px solid rgba(255,255,255,.05);
    border-radius: 12px; padding: 20px 24px;
    transition: border-color .2s, transform .2s, box-shadow .2s;
  }
  .edu-card:hover {
    border-color: rgba(203,166,247,.25);
    transform: translateX(4px);
    box-shadow: 0 4px 24px rgba(0,0,0,.3);
  }
  .edu-icon {
    flex-shrink: 0; width: 44px; height: 44px; border-radius: 10px;
    background: rgba(203,166,247,.1); border: 1px solid rgba(203,166,247,.2);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.2rem; color: var(--mauve);
  }
  .edu-content { flex: 1; }
  .edu-degree { font-size: .95rem; font-weight: 700; color: var(--text); margin-bottom: 4px; }
  .edu-school { font-size: .82rem; color: var(--sub0); }
  .edu-dates {
    font-family: var(--mono); font-size: .72rem; color: var(--sub0);
    background: rgba(203,166,247,.08); padding: 4px 10px; border-radius: 4px;
    white-space: nowrap;
  }

  @media (max-width: 600px) {
    .edu-card { flex-wrap: wrap; }
    .edu-dates { width: 100%; }
  }
</style>
