---
import { resume } from '../data/resume';
interface Props { data: typeof resume.skills; }
const { data } = Astro.props;
---

<section id="skills">
  <div class="skills-inner">
    <p class="section-eyebrow">04 · compétences</p>
    <p class="section-title">Compétences</p>
    <div class="skill-groups">
      {data.map((group, i) => (
        <div class="skill-group">
          <h3 class="group-label" style={`color: ${group.accent}`}>
            <span class="group-num">{`0${i + 1}`}</span>
            {group.group}
          </h3>
          <div class="group-badges">
            {group.items.map(item => (
              <span class="skill-badge" style={`--g: ${group.accent}`}>{item}</span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const io = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      entry.target.querySelectorAll<HTMLElement>('.skill-badge').forEach((badge, i) => {
        badge.style.transitionDelay = `${i * 40}ms`;
        badge.classList.add('visible');
      });
      io.unobserve(entry.target);
    });
  }, { threshold: 0.1 });

  document.querySelectorAll('.skill-group').forEach(g => io.observe(g));
</script>

<style>
  #skills { padding: 80px 0; }
  .skills-inner { max-width: 1100px; margin: 0 auto; padding: 0 48px; }

  .section-title {
    font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--sub0); display: flex; align-items: center; gap: 14px; margin-bottom: 40px;
  }
  .section-title::before { content: ''; display: block; width: 3px; height: 1.1em; background: var(--mauve); border-radius: 2px; box-shadow: 0 0 8px rgba(203,166,247,.5); }
  .section-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, rgba(203,166,247,.25), transparent); }

  .skill-groups { display: flex; flex-direction: column; gap: 32px; }
  .group-label { font-size: .72rem; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin-bottom: 12px; display: flex; align-items: center; }
  .group-num { font-family: var(--mono); font-size: .62rem; color: var(--s1); letter-spacing: .1em; margin-right: 10px; opacity: .8; font-weight: 400; }
  .group-badges { display: flex; flex-wrap: wrap; gap: 8px; }

  .skill-badge {
    font-family: var(--mono); font-size: .8rem; font-weight: 500;
    padding: 6px 14px; border-radius: 999px;
    background: rgba(255,255,255,.04); border: 1px solid rgba(255,255,255,.07);
    color: var(--text);
    opacity: 0;
    transform: translateY(12px);
    transition: opacity .4s ease, transform .4s ease, background .2s, color .2s, border-color .2s, box-shadow .2s;
  }
  .skill-badge.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .skill-badge:hover {
    background: color-mix(in srgb, var(--g) 15%, transparent);
    color: var(--g);
    border-color: color-mix(in srgb, var(--g) 35%, transparent);
    transform: translateY(-2px) scale(1.06);
    box-shadow: 0 0 12px color-mix(in srgb, var(--g) 25%, transparent);
  }
</style>
