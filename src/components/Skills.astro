---
import { resume } from '../data/resume';

interface Props {
  data: typeof resume.skills;
  basics: typeof resume.basics;
  education: typeof resume.education;
}
const { data, basics, education } = Astro.props;

const cards = [
  { key: 'daily',      label: 'au quotidien',  items: data.daily },
  { key: 'proficient', label: 'maîtrisé',      items: data.proficient },
  { key: 'familiar',   label: 'déjà pratiqué', items: data.familiar },
];

const diplomas = education.map((e) => `${e.degree} — ${e.school}, ${e.end}`);
const langs    = basics.languages.map((l) => `${l.lang} ${l.level}`);
const footline = [...diplomas, langs.join(', ')].join(' · ');
---
<section id="competences" class="section">
  <div class="container">
    <h2>Compétences</h2>

    <div class="grid">
      {cards.map((c) => (
        <div class="card" data-level={c.key}>
          <h3>{c.label}</h3>
          <p>{c.items.join(', ')}</p>
        </div>
      ))}
    </div>

    <p class="footline">{footline}</p>
  </div>
</section>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }

  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  h3 {
    font-family: var(--mono);
    font-size: 14px;
    font-weight: 500;
    color: var(--text-muted);
  }
  .card[data-level='daily'] h3 { color: var(--accent); }

  .card p { font-size: 16px; line-height: 1.6; color: var(--text-body); }
  .card[data-level='daily']      p { font-size: 18px; font-weight: 500; color: var(--text); }
  .card[data-level='familiar']   p { color: var(--text-muted); }

  .footline {
    margin-top: 32px;
    font-size: 16px;
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media print {
    .grid { grid-template-columns: repeat(3, minmax(0, 1fr)) !important; gap: 7pt !important; }
    .card {
      border: .5pt solid var(--border) !important;
      border-radius: 0 !important;
      padding: 7pt !important;
      gap: 4pt !important;
      break-inside: avoid;
    }
    h3 { font-size: 8pt !important; }
    .card p { font-size: 8.5pt !important; line-height: 1.4 !important; }
    .card[data-level='daily'] p { font-size: 9pt !important; }
    .footline { margin-top: 7pt !important; font-size: 8.5pt !important; }
  }
</style>
