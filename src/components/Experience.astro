---
import { resume } from '../data/resume';
import Icon from './Icon.astro';
import { byStartDesc, range, spanOf } from '../lib/dates';

interface Props {
  data: typeof resume.experience;
  earlyTitle: string;
  earlyNote: string;
}
const { data, earlyTitle, earlyNote } = Astro.props;

// Tri dans le code : l'ordre du tableau de données n'est pas fiable.
const jobs  = byStartDesc(data.filter((j) => !('early' in j && j.early)));
const early = byStartDesc(data.filter((j) => 'early' in j && j.early));
---
<section id="experience" class="section">
  <div class="container">
    <h2>Expérience</h2>

    <div class="list">
      {jobs.map((job) => (
        <article>
          <p class="dates">{range(job.start, job.end)}</p>

          <div class="body">
            <h3>
              {job.role}
              <span class="company">
                {'url' in job && job.url
                  ? <a href={job.url} rel="noopener">{job.company}<Icon name="external" size={13} /></a>
                  : job.company}
              </span>
            </h3>

            {'highlights' in job && job.highlights && (
              <ul>{job.highlights.map((h) => <li>{h}</li>)}</ul>
            )}

            {'tags' in job && job.tags && (
              <p class="tags">{job.tags.join(' · ')}</p>
            )}
          </div>
        </article>
      ))}

      {early.length > 0 && (
        <article class="early">
          <p class="dates">{spanOf(early)}</p>
          <div class="body">
            <h3 class="early-title">{earlyTitle}</h3>
            <p class="early-note">{earlyNote}</p>
          </div>
        </article>
      )}
    </div>
  </div>
</section>

<style>
  .list { display: flex; flex-direction: column; }

  article {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 40px;
    padding-block: 28px;
    border-bottom: 1px solid var(--border);
  }
  article:last-child { border-bottom: none; padding-bottom: 0; }

  .dates {
    flex: 0 0 200px;
    padding-top: 4px;
    font-family: var(--mono);
    font-size: 14px;
    color: var(--text-muted);
  }

  .body {
    flex: 999 1 480px;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  h3 {
    font-size: 21px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .company { font-weight: 400; color: var(--accent); }
  .company::before { content: ' · '; color: var(--text-muted); }
  .company a {
    color: inherit;
    text-decoration: none;
  }
  .company a:hover { text-decoration: underline; }
  /* :global — le <svg> vient de Icon.astro, il ne porte pas le scope de ce composant */
  .company a :global(svg) {
    display: inline-block;
    vertical-align: -1px;
    margin-left: 5px;
  }

  ul {
    padding-left: 20px;
    font-size: 16px;
    line-height: 1.65;
    color: var(--text-body);
  }
  li { margin-bottom: 2px; }

  .tags {
    font-family: var(--mono);
    font-size: 14px;
    line-height: 1.5;
    color: var(--text-muted);
  }

  .early .body { gap: 6px; }
  .early-title { font-size: 17px; color: var(--text-body); }
  .early-note { font-size: 15px; line-height: 1.65; color: var(--text-muted); }

  @media (max-width: 640px) {
    article { gap: 6px; padding-block: 22px; }
    .dates { flex: 1 1 100%; padding-top: 0; }
    h3 { font-size: 18px; }
    /* entreprise sur sa propre ligne */
    .company { display: block; }
    .company::before { content: none; }
  }

  @media print {
    article {
      gap: 2pt 14pt !important;
      padding-block: 7pt !important;
      border-bottom: .5pt solid var(--border) !important;
      break-inside: avoid;
    }
    article:last-child { padding-bottom: 0 !important; }
    .dates { flex: 0 0 104pt !important; padding-top: 1pt !important; font-size: 8pt !important; }
    .body { flex: 999 1 240pt !important; gap: 3pt !important; }
    h3 { font-size: 11pt !important; }
    ul { padding-left: 11pt !important; font-size: 9pt !important; line-height: 1.4 !important; }
    li { margin-bottom: 0 !important; }
    .tags { font-size: 8pt !important; }
    .early-title { font-size: 9.5pt !important; }
    .early-note { font-size: 8.5pt !important; line-height: 1.4 !important; }
    .company a :global(svg) { display: none !important; }
  }
</style>
