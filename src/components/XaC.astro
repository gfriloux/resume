---
import { resume } from '../data/resume';
interface Props { data: typeof resume.xac; }
const { data } = Astro.props;
---

<section id="xac">
  <div class="xac-inner">
    <p class="section-eyebrow">01 · everything-as-code</p>
    <p class="section-title">Infrastructure as Code</p>

    <div class="terminal-window" id="xac-terminal">
      <div class="terminal-header">
        <span class="dot red"></span><span class="dot yellow"></span><span class="dot green"></span>
        <span class="terminal-title">~/infrastructure — terraform &amp; nix</span>
      </div>
      <div class="terminal-body" id="terminal-body">
        <!-- Contenu tapé progressivement via JS -->
      </div>
    </div>

    <div class="xac-cards">
      {data.map(item => (
        <div class="xac-card" style={`--accent: ${item.accent}`}>
          <span class="card-icon"><i class={`nf ${item.icon}`}></i></span>
          <h3 class="card-name">{item.tool}</h3>
          <p class="card-desc">{item.desc}</p>
          <span class="card-tag">{item.tag}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Terminal typing on scroll — multi-colour syntax highlighting
  const K: Record<string, string> = {
    pr: '#a6e3a1', kw: '#cba6f7', fn: '#89b4fa', str: '#a6e3a1',
    opt: '#89dceb', cm: '#6c7086', ok: '#a6e3a1', num: '#fab387',
    at: '#cba6f7', tx: '#bac2de',
  };

  type Part = [string, string];
  const lines: Array<{ parts: Part[] }> = [
    { parts: [['❯ ', K.pr], ['terraform ', K.kw], ['plan', K.fn]] },
    { parts: [["  # génération du plan d'exécution", K.cm]] },
    { parts: [['  + ', K.ok], ['aws_instance', K.tx], ['.app_server[', K.tx], ['0', K.num], [']', K.tx]] },
    { parts: [['  + ', K.ok], ['aws_instance', K.tx], ['.app_server[', K.tx], ['1', K.num], [']', K.tx]] },
    { parts: [['  + ', K.ok], ['aws_security_group', K.tx], ['.allow_tls', K.tx]] },
    { parts: [['  Plan: ', K.tx], ['47', K.num], [' to add, ', K.tx], ['1', K.num], [' to change, ', K.tx], ['0', K.num], [' to destroy.', K.tx]] },
    { parts: [] },
    { parts: [['❯ ', K.pr], ['terraform ', K.kw], ['apply ', K.fn], ['--auto-approve', K.opt]] },
    { parts: [['  Apply complete! Resources: ', K.ok], ['47', K.num], [' added.', K.ok]] },
    { parts: [] },
    { parts: [['❯ ', K.pr], ['ansible-playbook ', K.kw], ['-i ', K.opt], ['inventory/production', K.str], [' deploy.yml', K.fn]] },
    { parts: [['  PLAY RECAP ── ', K.tx], ['ok=42 ', K.ok], ['changed=8 ', K.ok], ['failed=0', K.ok]] },
    { parts: [] },
    { parts: [['  # nixos/configuration.nix', K.cm]] },
    { parts: [['  services', K.at], ['.nginx', K.fn], ['.enable', K.fn], [' = ', K.tx], ['true', K.kw], [';', K.tx]] },
    { parts: [['  services', K.at], ['.nginx', K.fn], ['.virtualHosts', K.fn], ['."api.example.com"', K.str], [' = {', K.tx]] },
    { parts: [['    forceSSL', K.at], [' = ', K.tx], ['true', K.kw], ['; enableACME = ', K.tx], ['true', K.kw], [';', K.tx]] },
    { parts: [['  };', K.tx]] },
    { parts: [] },
    { parts: [['❯ ', K.pr], ['nixos-rebuild ', K.kw], ['switch ', K.fn], ['--flake ', K.opt], ['.#production', K.str]] },
    { parts: [['  activating the configuration... ', K.tx], ['[done]', K.ok]] },
  ];

  const termBody = document.getElementById('terminal-body');
  let revealed = false;

  if (termBody) {
    const blinkStyle = document.createElement('style');
    blinkStyle.textContent = '@keyframes term-blink { 50% { background: transparent } }';
    document.head.appendChild(blinkStyle);

    ScrollTrigger.create({
      trigger: '#xac-terminal',
      start: 'top 70%',
      onEnter: () => {
        if (revealed) return;
        revealed = true;
        let lineIdx = 0;
        const showLine = () => {
          if (lineIdx >= lines.length) {
            const cursor = document.createElement('span');
            cursor.style.cssText = 'display:inline-block;width:.6ch;height:1em;background:var(--mauve);margin-left:2px;vertical-align:text-bottom;animation:term-blink 1s steps(1) infinite';
            termBody.appendChild(cursor);
            return;
          }
          const { parts } = lines[lineIdx++];
          const div = document.createElement('div');
          div.style.cssText = 'line-height:1.7;font-size:.82rem;font-family:var(--mono);min-height:1.3em';
          if (parts.length === 0) {
            div.innerHTML = '&nbsp;';
          } else {
            parts.forEach(([text, color]) => {
              const span = document.createElement('span');
              span.textContent = text;
              span.style.color = color;
              div.appendChild(span);
            });
          }
          termBody.appendChild(div);
          termBody.scrollTop = termBody.scrollHeight;
          const len = parts.reduce((s, [t]) => s + t.length, 0);
          setTimeout(showLine, len ? Math.max(35, len * 4) : 20);
        };
        showLine();
      }
    });
  }

  // Cards scroll reveal — IntersectionObserver with stagger
  const cardIO = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        (e.target as HTMLElement).classList.add('visible');
        cardIO.unobserve(e.target);
      }
    });
  }, { rootMargin: '0px 0px -5% 0px' });

  document.querySelectorAll<HTMLElement>('.xac-card').forEach((card, i) => {
    card.style.transitionDelay = `${i * 100}ms`;
    cardIO.observe(card);
  });
</script>

<style>
  #xac { padding: 80px 0; }
  .xac-inner { max-width: 1100px; margin: 0 auto; padding: 0 48px; }

  .section-title {
    font-size: .7rem; font-weight: 700; letter-spacing: .12em; text-transform: uppercase;
    color: var(--sub0); display: flex; align-items: center; gap: 14px; margin-bottom: 40px;
  }
  .section-title::before { content: ''; display: block; width: 3px; height: 1.1em; background: var(--mauve); border-radius: 2px; box-shadow: 0 0 8px rgba(203,166,247,.5); }
  .section-title::after { content: ''; flex: 1; height: 1px; background: linear-gradient(to right, rgba(203,166,247,.25), transparent); }

  .terminal-window {
    background: var(--crust); border-radius: 12px;
    border: 1px solid rgba(255,255,255,.07);
    box-shadow: 0 8px 40px rgba(0,0,0,.5), 0 0 0 1px rgba(255,255,255,.03) inset;
    margin-bottom: 32px; overflow: hidden;
  }
  .terminal-header {
    display: flex; align-items: center; gap: 8px; padding: 10px 16px;
    background: var(--mantle); border-bottom: 1px solid rgba(255,255,255,.05);
  }
  .dot { width: 12px; height: 12px; border-radius: 50%; }
  .dot.red    { background: #ff5f57; }
  .dot.yellow { background: #febc2e; }
  .dot.green  { background: #28c840; }
  .terminal-title { flex: 1; text-align: center; font-family: var(--mono); font-size: .72rem; color: var(--sub0); }
  .terminal-body { padding: 20px 24px; min-height: 280px; max-height: 320px; overflow-y: auto; }
  .terminal-body::-webkit-scrollbar { width: 4px; }
  .terminal-body::-webkit-scrollbar-thumb { background: var(--s1); border-radius: 2px; }

  .xac-cards { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; }

  .xac-card {
    background: rgba(255,255,255,.025);
    border: 1px solid color-mix(in srgb, var(--accent) 25%, transparent);
    border-radius: 12px; padding: 24px 20px;
    transition: all .3s cubic-bezier(.4,0,.2,1), opacity .5s ease, transform .5s ease;
    position: relative; overflow: hidden;
    opacity: 0;
    transform: translateY(20px);
    display: flex; flex-direction: column;
  }
  .xac-card.visible {
    opacity: 1;
    transform: translateY(0);
  }
  .xac-card::before {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent) 8%, transparent), transparent);
    opacity: 0; transition: opacity .3s;
  }
  .xac-card:hover { transform: translateY(-5px) scale(1.02); border-color: color-mix(in srgb, var(--accent) 60%, transparent); box-shadow: 0 0 30px color-mix(in srgb, var(--accent) 18%, transparent), 0 12px 40px rgba(0,0,0,.4); }
  .xac-card:hover::before { opacity: 1; }
  .card-icon { display: block; font-size: 2rem; color: var(--accent); margin-bottom: 12px; }
  .card-name { font-size: 1rem; font-weight: 700; color: var(--text); margin-bottom: 6px; }
  .card-desc { font-size: .8rem; color: var(--sub0); line-height: 1.5; margin-bottom: 10px; flex: 1; }
  .card-tag { display: inline-block; font-family: var(--mono); font-size: .68rem; padding: 2px 8px; border-radius: 4px; background: color-mix(in srgb, var(--accent) 15%, transparent); color: var(--accent); margin-top: auto; align-self: flex-start; }

  @media (max-width: 768px) { .xac-cards { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 480px) { .xac-cards { grid-template-columns: 1fr; } }
</style>
