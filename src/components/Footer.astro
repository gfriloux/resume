---
import { resume } from '../data/resume';
import Icon from './Icon.astro';

interface Props { data: typeof resume.basics; }
const { data } = Astro.props;

const host = (url: string) => url.replace(/^https?:\/\//, '').replace(/\/$/, '');
const year = new Date().getFullYear();
---
<footer id="contact">
  <div class="container inner">
    <div class="top no-print">
      <h2 class="title">{data.contactTitle}</h2>
      <div class="actions">
        <a class="btn btn--primary" href={`mailto:${data.email}`}>
          <Icon name="mail" />M'écrire
        </a>
        <a class="btn btn--secondary" href={data.pdf}>
          <Icon name="download" />CV en PDF
        </a>
      </div>
    </div>

    <p class="legal">
      <span>© {year} {data.name}</span>
      <a href={data.github} rel="noopener">{host(data.github)}</a>
    </p>
  </div>
</footer>

<style>
  footer { border-top: 1px solid var(--border); }

  .inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
    padding-block: 56px 48px;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .title {
    font-size: 24px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  .actions { display: flex; flex-wrap: wrap; gap: 12px; }

  .legal {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
    font-size: 14px;
    color: var(--text-muted);
  }
  .legal a { color: var(--text-muted); text-decoration: none; }
  .legal a:hover { color: #fff; text-decoration: underline; }

  @media (max-width: 640px) {
    .inner { padding-block: 40px 36px; gap: 24px; }
    .title { font-size: 21px; }
  }

  @media print {
    footer { border-top: .5pt solid var(--border) !important; }
    .inner { padding-block: 6pt 0 !important; gap: 0 !important; }
    .legal { font-size: 8pt !important; gap: 2pt 12pt !important; }
  }
</style>
