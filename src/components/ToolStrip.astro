---
import { resume } from '../data/resume';
import Logo from './Logo.astro';

interface Props { data: typeof resume.signature; }
const { data } = Astro.props;
---
<section class="strip" aria-label="Outils du quotidien">
  <ul class="container row">
    {data.map((t) => (
      <li class="item">
        <Logo name={t.icon} size={28} />
        <span class="text">
          <span class="name">{t.name}</span>
          <span class="note">{t.note}</span>
        </span>
      </li>
    ))}
  </ul>
</section>

<style>
  .strip { border-top: 1px solid var(--border); }

  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 14px;
    list-style: none;
    padding-block: 28px;
  }

  .item {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    min-width: 0;
    padding: 18px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }
  /* :global — le <svg> vient de Logo.astro, il ne porte pas le scope de ce composant */
  .item :global(svg) { flex: none; color: var(--accent); }

  .text { display: flex; flex-direction: column; gap: 2px; min-width: 0; }

  .name { font-size: 17px; font-weight: 600; color: var(--text); }

  .note { font-size: 14px; line-height: 1.3; color: var(--text-muted); }

  @media (max-width: 640px) {
    .row { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 12px; padding-block: 20px; }
    .item { padding: 14px; gap: 10px; }
    .name { font-size: 15px; }
    .note { font-size: 13px; }
  }

  @media print {
    /* Une ligne compacte : c'est elle qui porte la stack dans le PDF */
    .strip { border-top: .5pt solid var(--border) !important; }
    .row {
      display: flex !important;
      flex-wrap: wrap !important;
      gap: 6pt 18pt !important;
      padding-block: 6pt !important;
    }
    .item {
      align-items: center !important;
      gap: 5pt !important;
      padding: 0 !important;
      background: none !important;
      border: none !important;
      border-radius: 0 !important;
    }
    .item :global(svg) { width: 10pt !important; height: 10pt !important; }
    .name { font-family: var(--mono) !important; font-size: 8.5pt !important; font-weight: 400 !important; }
    .note { display: none !important; }
  }
</style>
