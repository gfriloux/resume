---
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '../styles/global.css';

const title       = 'CV — Guillaume Friloux';
const description =
  "CV de Guillaume Friloux — Administrateur système Linux, Infrastructure as Code : 200+ serveurs décrits en Terraform, Ansible et Nix. Ouvert aux opportunités en télétravail.";
const canonical   = new URL(Astro.url.pathname, Astro.site);
const ogImage     = new URL('social-card.png', Astro.site);
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content={description} />
  <title>{title}</title>
  <link rel="canonical" href="https://guillaume.friloux.me/" />

  <link rel="icon" href="/favicon.ico" sizes="32x32" />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta name="theme-color" content="#1e1e2e" />

  <meta property="og:type" content="profile" />
  <meta property="og:locale" content="fr_FR" />
  <meta property="og:site_name" content="Guillaume Friloux" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <!-- TODO : social-card.png date du design précédent — à régénérer (just social-card)
       une fois le nouveau hero validé. -->
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content="Guillaume Friloux — Administrateur système Linux" />
  <meta property="profile:first_name" content="Guillaume" />
  <meta property="profile:last_name" content="Friloux" />

  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
</head>
<body>
  <slot />
</body>
</html>
