---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
---
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="description" content="CV de Guillaume Friloux — Administrateur Système Linux, expert Terraform, NixOS, AWS." />
  <title>CV — Guillaume Friloux</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
  <link href="https://www.nerdfonts.com/assets/css/webfont.css" rel="stylesheet">
</head>
<body>
  <div id="progress"></div>
  <canvas id="bg-canvas"></canvas>
  <Nav />
  <main>
    <slot />
  </main>
  <script>
    // Progress bar
    window.addEventListener('scroll', () => {
      const pct = scrollY / (document.body.scrollHeight - innerHeight) * 100;
      const el = document.getElementById('progress');
      if (el) el.style.width = Math.min(pct,100)+'%';
    }, { passive: true });
  </script>
</body>
</html>
